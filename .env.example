# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Frontend Safe - Gunakan HANYA anon/publishable key)
# PENTING: JANGAN PERNAH menempatkan Supabase service_role key di variabel VITE_!
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Identitas sekolah opsional untuk memisahkan data pertandingan antar sekolah (RLS)
VITE_SCHOOL_ID="sd-aqua-city"
